# K3s Cluster Bootstrap Environment Variables Template
# Copy this file to .env and fill in your values

# ===== REQUIRED CONFIGURATION =====

# Domain Configuration
# Your base domain for all services (e.g., example.com)
DOMAIN=

# GitHub OAuth Configuration
# Create OAuth App at: https://github.com/settings/applications/new
# Homepage URL: https://${DOMAIN}
# Authorization callback URL: https://${DOMAIN}/oauth2/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ===== OPTIONAL CONFIGURATION =====

# GitHub Organization Restriction (leave empty to allow all GitHub users)
GITHUB_ORG=

# Administrator Configuration
# Used as default admin for various services
ADMIN_USER=admin
ADMIN_EMAIL=admin@${DOMAIN}

# Email Configuration (for notifications, password resets, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=noreply@${DOMAIN}

# ===== CLOUD PROVIDER CONFIGURATION =====

# Hetzner Cloud (required for --environment hetzner)
HETZNER_API_TOKEN=

# ===== SERVICE-SPECIFIC CONFIGURATION =====

# MinIO S3 Storage (auto-generated if not specified)
# MINIO_ROOT_USER=admin
# MINIO_ROOT_PASSWORD=

# Google OAuth (for Plausible Analytics Google Search Console integration)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# MaxMind GeoIP (for Plausible Analytics location data)
# Register at: https://www.maxmind.com/en/geolite2/signup
MAXMIND_LICENSE_KEY=

# ===== BACKUP CONFIGURATION =====

# S3 Backup Configuration (for Velero)
# Can use MinIO or external S3
BACKUP_S3_BUCKET=backups
BACKUP_S3_ENDPOINT=https://s3.${DOMAIN}
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# ===== MONITORING CONFIGURATION =====

# Grafana Configuration
GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD= (auto-generated if not specified)

# AlertManager Configuration
# Slack webhook for alerts
ALERTMANAGER_SLACK_WEBHOOK=
ALERTMANAGER_SLACK_CHANNEL=#alerts

# ===== DEVELOPMENT CONFIGURATION =====

# Harbor Registry
# HARBOR_ADMIN_PASSWORD= (auto-generated if not specified)

# Drone CI
# After Gitea OAuth setup, update these:
# DRONE_GITEA_CLIENT_ID=
# DRONE_GITEA_CLIENT_SECRET=

# ===== RESOURCE LIMITS =====

# Set resource limits for components (examples)
# PROMETHEUS_MEMORY_LIMIT=2Gi
# GRAFANA_MEMORY_LIMIT=1Gi
# NEXTCLOUD_MEMORY_LIMIT=2Gi
# MINIO_MEMORY_LIMIT=1Gi

# ===== FEATURE FLAGS =====

# Enable/disable optional features
ENABLE_MONITORING_PERSISTENCE=true
ENABLE_BACKUP_ENCRYPTION=true
ENABLE_NETWORK_POLICIES=false
ENABLE_POD_SECURITY_POLICIES=false

# ===== CLUSTER CONFIGURATION =====

# K3s Configuration
K3S_NODE_NAME=${HOSTNAME}
K3S_CLUSTER_SECRET=$(openssl rand -base64 32)

# Storage Configuration
DEFAULT_STORAGE_CLASS=local-path
# For production, consider using:
# DEFAULT_STORAGE_CLASS=longhorn

# ===== NOTES =====
# 
# 1. Never commit the .env file to version control
# 2. Use strong, unique passwords for all services
# 3. Rotate credentials regularly
# 4. Keep this file backed up securely
# 5. Some values are auto-generated during installation if not provided
#
# For detailed configuration options, see:
# https://github.com/yourusername/k3s-cluster-bootstrap/docs/configuration.md