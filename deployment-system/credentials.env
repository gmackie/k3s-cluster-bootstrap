# Helper functions
harbor_login() {
    docker login $HARBOR_URL -u $HARBOR_USER -p $HARBOR_PASSWORD
}

argocd_login() {
    local password=$(kubectl -n argocd get secret argocd-initial-admin-secret -o jsonpath="{.data.password}" | base64 -d)
    argocd login $ARGOCD_URL --username $ARGOCD_USER --password "$password" --insecure
}

create_app_secret() {
    local namespace=$1
    local app_name=${2:-$namespace}
    
    kubectl create namespace $namespace --dry-run=client -o yaml | kubectl apply -f -
    
    kubectl create secret docker-registry harbor-secret \
        --docker-server=$HARBOR_URL \
        --docker-username=$HARBOR_USER \
        --docker-password=$HARBOR_PASSWORD \
        -n $namespace --dry-run=client -o yaml | kubectl apply -f -
    
    echo "Created namespace and Harbor secret for $namespace"
}